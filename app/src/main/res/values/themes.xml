<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme -->
    <style name="Theme.AddVenture" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.AddVenture.Splash" parent="Theme.AddVenture">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <!-- Game Button Styles -->
    <style name="GameButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="GameButton.Primary" parent="GameButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="GameButton.Secondary" parent="GameButton">
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="GameButton.Accent" parent="GameButton">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="GameButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Card Styles -->
    <style name="GameCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/spacing_md</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- Text Styles -->
    <style name="TextTitle">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextDisplay">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <!-- Strategy Card -->
    <style name="StrategyCard" parent="GameCard">
        <item name="cardElevation">@dimen/card_elevation_high</item>
    </style>

    <!-- Number Button Style -->
    <style name="NumberButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:minWidth">@dimen/number_button_size</item>
        <item name="android:minHeight">@dimen/number_button_size</item>
        <item name="cornerRadius">@dimen/corner_round</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_md"
    app:cardCornerRadius="@dimen/corner_lg"
    app:cardElevation="@dimen/card_elevation_high"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_lg">

        <!-- Owl Librarian Illustration -->
        <ImageView
            android:id="@+id/imgOwlLibrarian"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/injured_owl"
            android:contentDescription="Owl Librarian"
            android:scaleType="fitCenter"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="Whoops! Let's recount!"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Our wise librarian owl suggests recounting the fruits in the drop zone. You can do this!"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_md"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Try Again Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogTryAgain"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Try Again"
                android:textAllCaps="false"
                android:textSize="@dimen/text_sm"
                android:fontFamily="sans-serif-bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/corner_lg"
                android:textColor="@color/white"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Need Hint Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogHint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Need a hint?"
                android:textAllCaps="false"
                android:textSize="@dimen/text_sm"
                android:fontFamily="sans-serif-bold"
                app:backgroundTint="@color/accent"
                app:cornerRadius="@dimen/corner_lg"
                android:textColor="@color/text_primary"
                app:icon="@android:drawable/ic_menu_help"
                app:iconTint="@color/text_primary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

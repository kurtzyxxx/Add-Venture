<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:elevation="2dp"
        android:background="@color/white">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_lg"
            android:letterSpacing="-0.02" />

        <!-- Star Counter Chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_star_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textColor="@color/star_gold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTotalStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="0"
                android:textColor="@color/star_gold"
                android:textSize="@dimen/text_md" />

        </LinearLayout>

    </LinearLayout>

    <!-- Welcome Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Welcome Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <ImageView
                        android:id="@+id/imgHomeOwl"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/happy_owl"
                        android:contentDescription="Oliver the Owl"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="@dimen/spacing_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWelcomeUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Hello, Learner!"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ready for an addition adventure?"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Strategy Cards Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:fontFamily="sans-serif-bold"
                android:text="Choose a Strategy"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md"
                android:letterSpacing="0.02"
                android:textAllCaps="true" />

            <!-- Count All Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCountAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:rippleColor="@color/count_all_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_strategy_count_all"
                    android:padding="20dp">

                    <!-- Color indicator bar -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="48dp"
                        android:background="@color/count_all_color"
                        android:layout_marginEnd="@dimen/spacing_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Count All"
                            android:textColor="@color/count_all_color"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Count every object to find the total"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCountAllArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textColor="@color/count_all_color"
                        android:textSize="@dimen/text_lg"
                        android:fontFamily="sans-serif-bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Count On Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCountOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:rippleColor="@color/count_on_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_strategy_count_on"
                    android:padding="20dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="48dp"
                        android:background="@color/count_on_color"
                        android:layout_marginEnd="@dimen/spacing_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Count On"
                            android:textColor="@color/count_on_color"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Start from a number and count forward"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCountOnArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textColor="@color/count_on_color"
                        android:textSize="@dimen/text_lg"
                        android:fontFamily="sans-serif-bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Number Bonds Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNumberBonds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:rippleColor="@color/number_bonds_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_strategy_number_bonds"
                    android:padding="20dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="48dp"
                        android:background="@color/number_bonds_color"
                        android:layout_marginEnd="@dimen/spacing_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Number Bonds"
                            android:textColor="@color/number_bonds_color"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Find the missing number in a pair"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNumberBondsArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textColor="@color/number_bonds_color"
                        android:textSize="@dimen/text_lg"
                        android:fontFamily="sans-serif-bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Adventure Map Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdventureMap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_large"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="Adventure Map"
                android:textAllCaps="false"
                android:textSize="@dimen/text_md"
                android:fontFamily="sans-serif-bold"
                app:backgroundTint="@color/accent"
                app:cornerRadius="@dimen/corner_lg"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_lg" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvTotalStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="0"
                android:textColor="@color/star_gold"
                android:textSize="@dimen/text_md" />

        </LinearLayout>

    </LinearLayout>

    <!-- Welcome Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Welcome Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardElevation="@dimen/card_elevation_high"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🦉"
                        android:textSize="64sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="sans-serif-black"
                        android:text="Hello, Learner!"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_xl" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Ready for an addition adventure? 🎮"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_md" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Strategy Cards Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:fontFamily="sans-serif-bold"
                android:text="Choose a Strategy 🎯"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_lg" />

            <!-- Count All Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCountAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/count_all_light"
                app:rippleColor="@color/count_all_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍎"
                        android:textSize="40sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/strategy_count_all"
                            android:textColor="@color/count_all_color"
                            android:textSize="@dimen/text_lg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Count all objects to find the total!"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textColor="@color/count_all_color"
                        android:textSize="@dimen/text_lg" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Count On Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCountOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/count_on_light"
                app:rippleColor="@color/count_on_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔢"
                        android:textSize="40sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/strategy_count_on"
                            android:textColor="@color/count_on_color"
                            android:textSize="@dimen/text_lg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start big and count forward!"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textColor="@color/count_on_color"
                        android:textSize="@dimen/text_lg" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Number Bonds Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNumberBonds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/number_bonds_light"
                app:rippleColor="@color/number_bonds_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧩"
                        android:textSize="40sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/strategy_number_bonds"
                            android:textColor="@color/number_bonds_color"
                            android:textSize="@dimen/text_lg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Find the missing part!"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textColor="@color/number_bonds_color"
                        android:textSize="@dimen/text_lg" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Adventure Map Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdventureMap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_large"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="🗺️  Adventure Map"
                android:textAllCaps="false"
                android:textSize="@dimen/text_md"
                android:fontFamily="sans-serif-bold"
                app:backgroundTint="@color/accent"
                app:cornerRadius="@dimen/corner_lg"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>

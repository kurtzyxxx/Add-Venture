<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game"
    android:orientation="vertical">

    <!-- Top Bar: Timer + Stars + Difficulty -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        android:background="@color/white">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:scaleType="centerInside" />

        <!-- Timer -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Time: "
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md" />

        </LinearLayout>

        <!-- Stars -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textColor="@color/star_gold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="+0"
                android:textColor="@color/star_gold"
                android:textSize="@dimen/text_sm" />

        </LinearLayout>

        <!-- Difficulty badge -->
        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_rounded"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Easy"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_xs" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Activity Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="Count All"
                android:textColor="@color/count_all_color"
                android:textSize="20sp" />

            <!-- Instruction with Oliver the Owl Guide -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/imgOwlCheer"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/lost_owl"
                    android:contentDescription="Oliver the Owl Guide"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:gravity="start|center_vertical"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/count_all_instruction"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Problem display: num1 + num2 = ? -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/tvNum1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="3"
                    android:textColor="@color/count_all_color"
                    android:textSize="@dimen/text_xxl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:fontFamily="sans-serif-black"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_xl" />

                <TextView
                    android:id="@+id/tvNum2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="2"
                    android:textColor="@color/secondary"
                    android:textSize="@dimen/text_xxl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:fontFamily="sans-serif-black"
                    android:text="="
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_xl" />

                <TextView
                    android:id="@+id/tvAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="?"
                    android:textColor="@color/accent_dark"
                    android:textSize="@dimen/text_xxl" />

            </LinearLayout>

            <!-- Fruit objects area & Drop Zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/spacing_md">

                <!-- Group 1 Fruits -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:cardCornerRadius="@dimen/corner_md"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tvGroup1Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Group 1"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:layout_marginBottom="@dimen/spacing_xs" />

                        <LinearLayout
                            android:id="@+id/containerGroup1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Group 2 Fruits -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:cardCornerRadius="@dimen/corner_md"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tvGroup2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Group 2"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:layout_marginBottom="@dimen/spacing_xs" />

                        <LinearLayout
                            android:id="@+id/containerGroup2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Drag Zone / Drop here! -->
                <LinearLayout
                    android:id="@+id/layoutDropZone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="140dp"
                    android:background="@drawable/bg_drop_zone"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvDropZoneLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drag all food tokens here to count!"
                        android:textColor="@color/drop_zone_border"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="@dimen/text_md"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <LinearLayout
                        android:id="@+id/containerDropZone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- Answer Input -->
            <LinearLayout
                android:id="@+id/layoutAnswerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/your_answer"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="@dimen/text_md" />

                <!-- Number picker buttons -->
                <LinearLayout
                    android:id="@+id/numberButtonsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:orientation="horizontal">
                    <!-- Populated programmatically -->
                </LinearLayout>

            </LinearLayout>

            <!-- Selected answer display -->
            <TextView
                android:id="@+id/tvSelectedAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_xl"
                android:text="Tap a number!" />

            <!-- Feedback area -->
            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_sm"
                android:fontFamily="sans-serif-bold"
                android:textSize="@dimen/text_md"
                android:visibility="gone" />

            <!-- Buttons: Hint + Submit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHint"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="@string/btn_hint"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_sm"
                    android:fontFamily="sans-serif-bold"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="@dimen/corner_lg"
                    android:textColor="@color/text_primary"
                    app:icon="@android:drawable/ic_menu_help"
                    app:iconTint="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="@string/btn_submit"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_sm"
                    android:fontFamily="sans-serif-bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/corner_lg"
                    android:textColor="@color/white" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

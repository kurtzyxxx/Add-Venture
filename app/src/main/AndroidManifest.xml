<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".AddVentureApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AddVenture">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AddVenture.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.OwlIntroActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AdventureMapActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CountAllActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.CountOnActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.NumberBondsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ProgressActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SessionSummaryActivity"
            android:exported="false" />

    </application>

</manifest>
